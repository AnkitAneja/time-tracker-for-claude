{
  "name": "time-tracker-for-claude",
  "version": "0.1.2",
  "description": "Menu bar app that tracks active Claude Code time per task, named automatically from the conversation",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "node scripts/make-tray-icon.mts && node scripts/make-app-icon.mts",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron@45.2.3": true
  },
  "productName": "Time Tracker for Claude Code",
  "author": "ankit",
  "license": "MIT",
  "build": {
    "appId": "io.github.ankitaneja.time-tracker-for-claude",
    "productName": "Time Tracker for Claude Code",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "!node_modules/better-sqlite3/{src,deps,docs,benchmark}/**",
      "!node_modules/better-sqlite3/prebuilds/linux*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "extendInfo": {
        "LSUIElement": false
      },
      "files": [
        "!node_modules/better-sqlite3/prebuilds/win32*"
      ],
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Time-Tracker-for-Claude-Code-${version}-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!node_modules/better-sqlite3/prebuilds/darwin*"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Time-Tracker-for-Claude-Code-Setup-${version}.exe"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "AnkitAneja",
        "repo": "time-tracker-for-claude",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AnkitAneja/time-tracker-for-claude.git"
  }
}
